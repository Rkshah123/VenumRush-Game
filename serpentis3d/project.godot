; Engine configuration file.
; SERPENTIS 3D — original 3D snake arena game.

config_version=5

[application]

config/name="SERPENTIS 3D"
config/description="Evolve. Hunt. Dominate. An original 3D snake arena survival game."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

SaveMgr="*res://scripts/core/save_manager.gd"
AudioMgr="*res://scripts/core/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.086, 1)
